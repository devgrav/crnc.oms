<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <!-- Серверный SignalR (Hub<T>, IHubContext<,>) с ASP.NET Core 3.0 живёт в shared
           framework, а не в NuGet. Раньше здесь стоял PackageReference на
           Microsoft.AspNetCore.SignalR 1.1.0 - пакет эпохи 2.1, дублировавший типы
           хоста. См. §7 плана миграции.
           Microsoft.Extensions.Logging.Abstractions отдельным пакетом больше не нужен -
           он приходит из того же shared framework (иначе NU1510). -->
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
